// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Daerah {
  id          Int      @id @default(autoincrement())
  nama_daerah String
  status      String    @default("Nonaktif")
  gambar_url  String

  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // Relasi ke cabang
  cabang      Cabang[]
}

model Cabang {
  id               Int      @id @default(autoincrement())
  daerah_id        Int

  // Relasi ke tabel Daerah
  daerah           Daerah   @relation(fields: [daerah_id], references: [id])

  alamat           String
  maps_iframe      String?
  status           String
  tanggal_dibuka   DateTime
  nama_penanggung  String
  email_kontak     String
  nomor_kontak     String
  
  // Disimpan sebagai JSON string
  hari_operasional String?  // contoh: ["Senin","Selasa","Rabu"]

  jam_buka         String
  jam_tutup        String
  gambar_url       String?

  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
}

model User {
  id         Int      @id @default(autoincrement())
  name       String?
  email      String   @unique
  password   String
  role       Role     @default(USER)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum Role {
  ADMIN
  USER
}